---
import LiveRex from './landing/LiveRex.astro';
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure>
  <LiveRex remote />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  figure {
    margin: 1.5rem 0;
  }
  figcaption {
    padding-top: 0.6rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
