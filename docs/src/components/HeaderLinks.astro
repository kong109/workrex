---
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a class="header-link docs-link" href={`${base}/guide/`}>Docs</a>
<a class="header-link" href={`${base}/changelog/`}>Changelog</a>
<a class="header-link" href={`${base}/llms.txt`}>LLMs</a>
<span class="github-link"><SocialIcons /></span>

<style>
  .header-link {
    display: none;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .docs-link {
    display: inline-flex;
  }

  .github-link {
    display: contents;
  }

  .header-link:hover,
  .header-link:focus-visible {
    color: var(--sl-color-white);
  }

  .header-link:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid currentColor;
    outline-offset: 0.25rem;
  }

  @media (max-width: 49.99rem) {
    :global(header) .github-link {
      display: none;
    }
  }

  @media (min-width: 50rem) {
    .header-link {
      display: inline-flex;
    }
  }
</style>
