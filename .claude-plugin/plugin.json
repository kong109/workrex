{
  "name": "workrex-status",
  "description": "Display Claude agent status in Rex session status via workrex",
  "version": "1.1.0",
  "author": {
    "name": "Workrex contributors"
  },
  "repository": "https://github.com/kong109/workrex",
  "license": "MIT",
  "keywords": [
    "rex",
    "workrex",
    "status",
    "agent"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "workrex register-agent"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workrex set-window-status working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workrex set-window-status waiting"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workrex set-window-status working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workrex set-window-status done"
          }
        ]
      }
    ]
  }
}
